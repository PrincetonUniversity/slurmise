#!/bin/bash
# Allocates roughly <intensity> MB (with +/-20% random noise) and sleeps for
# <duration> seconds.

while [[ $# -gt 0 ]]; do
    case $1 in
        --intensity) intensity=$2; shift 2;;
        --duration) duration=$2; shift 2;;
        *) echo "Unknown option: $1"; exit 1;;
    esac
done

if [[ -z "$intensity" || -z "$duration" ]]; then
    echo "Usage: complexMemScaler --intensity <MB> --duration <seconds>"
    exit 1
fi

noise_pct=$(( (RANDOM % 41) - 20 ))
actual_intensity=$(( intensity + intensity * noise_pct / 100 ))
[[ $actual_intensity -lt 1 ]] && actual_intensity=1

yes | tr \\n x | head -c "${actual_intensity}m" | tail | sleep "$duration"
