#!/usr/bin/env python3
"""Allocates <intensity> MB of memory and holds it for <duration> seconds.

Deterministic: resident memory usage exactly matches --intensity for the
full --duration, so SLURM's MaxRSS accounting captures a sustained value.
"""

import argparse
import time


def main():
    parser = argparse.ArgumentParser(description="Allocate memory and hold it for a fixed duration.")
    parser.add_argument("--intensity", type=int, default=1000, help="megabytes of memory to allocate")
    parser.add_argument("--duration", type=int, default=2, help="seconds to hold the allocation")
    args = parser.parse_args()

    # bytearray zero-fills the buffer, forcing every page resident so the
    # allocation shows up in SLURM's MaxRSS rather than being lazily reserved.
    _ = bytearray(args.intensity * 1024 * 1024)
    time.sleep(args.duration)


if __name__ == "__main__":
    main()
