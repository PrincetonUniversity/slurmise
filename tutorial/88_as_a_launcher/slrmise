#!/usr/bin/env python3
"""Prototype of slurmise as a launcher: wrap the command the way `time` does.

Today slurmise is told about a job *after* the fact -- you srun the command,
then hand `record` the same command a second time as a quoted string. This
prototype adds a second way: `lazy-record` takes the command itself, records a
stub row for it, and then becomes that command via `os.execvp`. Written once,
run once, and because it runs inside the srun step it can read SLURM_STEP_ID
rather than being told.

The cost is that a stub has no metrics: they arrive later, when `sync` asks
sacct about a step that has since finished. Both halves are here so the lesson
can put the two rows side by side.

Deliberately misspelled (no `u`) and not on PATH -- it is always `./slrmise`,
never `slurmise`. `tutorial/99_slurmise_run/slrmise` is its sibling, and goes
one step further by owning the sbatch too.
"""

from __future__ import annotations

import os
import pathlib
import shlex
import sys

import click

from slurmise import slurm
from slurmise.config import SlurmiseConfiguration
from slurmise.job_data import JobData
from slurmise.job_database import JobDatabase

TERMINAL_STATES = {"COMPLETED", "FAILED", "TIMEOUT", "OUT_OF_MEMORY", "CANCELLED"}


# ---------------------------------------------------------------------------
# sacct helpers
# ---------------------------------------------------------------------------
# These would be moved to slurm.py in src/slurmise


def fetch_sacct(job_id: str) -> dict | None:
    """Return the sacct JSON for a job, or None if it isn't available yet.

    This is the one genuinely-expected failure (a job too fresh to appear, or
    sacct erroring), so it fails quietly -- `sync` simply tries again next time.
    """
    try:
        sacct_json = slurm.get_slurm_job_sacct(job_id)
    except ValueError:
        return None
    return sacct_json if sacct_json.get("jobs") else None


def job_state(sacct_json: dict) -> str:
    """Return the job-level state from sacct JSON output."""
    try:
        return sacct_json["jobs"][0]["state"]["current"][0]
    except Exception as e:
        raise ValueError(f"Could not parse job state from sacct cmd:\n\n {sacct_json}") from e


def step_state(sacct_json: dict, step_key: str) -> str | None:
    """Return the state of step `<jobid>.<stepid>`, or None if sacct doesn't list it yet.

    Step-level, not job-level: a lazy row *is* a step, and while the batch job
    that launched it is still RUNNING its earlier steps have long since
    finished. Asking the job would freeze every row until the whole job ends.
    """
    try:
        steps = sacct_json["jobs"][0]["steps"]
    except Exception as e:
        raise ValueError(f"Could not parse job steps from sacct cmd:\n\n {sacct_json}") from e
    for step in steps:
        if step["step"]["id"] == step_key:
            return step["state"][0]
    return None


# ----------------------------------------------------------------------------
# Running without a scheduler
# ----------------------------------------------------------------------------
# If these envvars are set, don't involve SLURM at all: record what the caller
# says the job would have used, and (for lazy-record) don't exec the command
# either. The point is to let the tutorial be walked with no cluster, and
# without waiting on a queue for a five-second job.
#
# The declared usage is "stashed" in the h5 group attributes so the workflow is
# still stub-then-sync -- `sync` reads it back from there instead of sacct. This
# is a hack for the slurm-free tutorial, not something a real slurmise would do.

USED_MEM_VAR = "SLRMISE_USED_MEM"  # MB
USED_TIME_VAR = "SLRMISE_USED_TIME"  # seconds
MOCK_JOB_VAR = "SLRMISE_MOCK_JOB"  # the job id the scheduler would have handed out


def declared_usage() -> dict[str, int]:
    """The declared usage, ready to splat onto the job's h5 attrs. `{}` if none.

    Empty means "really use SLURM". Both or neither: a half-specified usage is
    almost certainly a typo, and silently submitting a real job because one
    variable was misspelled is the worst possible way to find that out.
    """
    mem, secs = os.environ.get(USED_MEM_VAR), os.environ.get(USED_TIME_VAR)
    if mem is None and secs is None:
        return {}
    if mem is None or secs is None:
        missing = USED_MEM_VAR if mem is None else USED_TIME_VAR
        raise click.UsageError(f"{missing} must be set too -- declare both or neither")
    try:
        return {"used_mem": int(mem), "used_time": int(secs)}
    except ValueError:
        raise click.UsageError(f"{USED_MEM_VAR}/{USED_TIME_VAR} must be whole numbers (MB and seconds)") from None


def next_mock_step(db_filename) -> tuple[str, str]:
    """A fabricated `<jobid>`, `<stepid>` for the no-cluster path.

    Only reached when there is no scheduler to hand out either of them. The job
    id comes from SLRMISE_MOCK_JOB, so one mock script -- standing in for one
    sbatch -- puts all of its steps under one job the way the real thing would.
    The default sits well above any id a tutorial cluster would issue, so a
    mocked row is never mistaken for one SLURM really assigned.

    The step is simply the next one free under that job. That is what lets the
    mocked launcher loop get away without a counter, exactly like the real one.
    """
    job_id = os.environ.get(MOCK_JOB_VAR, "90000001")
    steps = [
        int(step_id)
        for row in collect_rows(db_filename)
        for row_job, _, step_id in [str(row["slurm_id"]).partition(".")]
        if row_job == job_id and step_id.isdigit()
    ]
    return job_id, str(max(steps, default=-1) + 1)


# ----------------------------------------------------------------------------
# Job utilities
# ----------------------------------------------------------------------------


def set_job_attrs(db: JobDatabase, jd: JobData, **attrs) -> None:
    """Add attributes (method, state, declared usage) on a job's HDF5 group."""
    table = db.db[JobDatabase.get_table_name(jd)]
    for key, value in attrs.items():
        table.attrs[key] = value


def find_unsettled(db: JobDatabase) -> list[JobData]:
    """Return rows that are not yet "settled" (both metrics AND a terminal state).

    A stub is unsettled because it has no metrics; an eager row recorded
    mid-job is unsettled because its state is still RUNNING. Both converge here.

    NOTE: a real implementation would index pending jobs instead of walking
    the whole database on every sync.
    """
    pending = []
    for _, jobs in db.iterate_database():
        for jd in jobs:
            state = db.db[JobDatabase.get_table_name(jd)].attrs.get("state")
            has_metrics = jd.runtime is not None and jd.memory is not None
            if not (has_metrics and state in TERMINAL_STATES):
                pending.append(jd)
    return pending


def sync_pending(db_filename) -> None:
    """Synchronize the database with sacct: refresh states, fill in metrics.

    Failed rows (TIMEOUT/OUT_OF_MEMORY/...) keep their state as evidence rather
    than being retried or discarded.
    """
    with JobDatabase.get_database(db_filename) as db:
        for jd in find_unsettled(db):
            attrs = db.db[JobDatabase.get_table_name(jd)].attrs

            # The slurm-free path: the usage was declared up front and stashed
            # on the row, so there is nothing to ask sacct about.
            if "used_mem" in attrs:
                _settle_declared(db, jd, int(attrs["used_time"]), int(attrs["used_mem"]))
                continue

            job_id, step_id = slurm.split_job_id(jd.slurm_id)
            sacct_json = fetch_sacct(job_id)
            if sacct_json is None:
                continue  # not in the accounting database yet; try again next time

            state = step_state(sacct_json, f"{job_id}.{step_id}") if step_id is not None else job_state(sacct_json)
            if state is None:
                continue  # step not listed yet

            # Always refresh the state -- this is what moves an eager row
            # recorded mid-job from RUNNING to its terminal state.
            set_job_attrs(db, jd, state=state)

            # Metrics only once terminal, and only when missing. A terminal
            # step's metrics never change, so they are never overwritten.
            if state in TERMINAL_STATES and (jd.runtime is None or jd.memory is None):
                try:
                    # slurmise already knows how to do this: it splits the
                    # `<jobid>.<stepid>` key and asks sacct about that step.
                    db.update_missing_data([jd])
                except ValueError:
                    continue  # metrics not in sacct yet; the row stays pending


def _settle_declared(db: JobDatabase, jd: JobData, elapsed: int, max_rss: int) -> None:
    """Fill a stub from a usage the caller declared, with no SLURM involved."""
    set_job_attrs(db, jd, state="COMPLETED")
    if jd.runtime is not None and jd.memory is not None:
        return
    db.record(
        JobData(
            job_name=jd.job_name,
            slurm_id=jd.slurm_id,
            categories=jd.categories,
            runtime=elapsed if jd.runtime is None else None,
            memory=max_rss if jd.memory is None else None,
        )
    )


# ---------------------------------------------------------------------------
# display
# ---------------------------------------------------------------------------

# `state` must stay last before `features`: the tutorial's `#>` checks match
# patterns like /lazy\s+COMPLETED/ and /-\s+-\s+lazy/, which only work if those
# cells land on the same printed line in this order.
FIXED_COLUMNS = ("slurm_id", "job_name", "runtime", "memory", "method", "state")
HEADERS = ("job_id", "job", "used_time", "used_mem", "how", "state")


def _fmt(value) -> str:
    """Render a metric/attr for the table -- unknowns show as '-', not 'None'."""
    return "-" if value is None else str(value)


def _feature(value) -> str:
    """Features are stored as floats; show whole numbers as ints (2000, not 2000.0)."""
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value)


def _features(features: dict) -> str:
    """`{duration: 5, intensity: 2000}` -- a dict without the float noise and
    quoting a repr would add. Kept on one line so a row stays greppable."""
    return "{" + ", ".join(f"{k}: {_feature(v)}" for k, v in sorted(features.items())) + "}"


def collect_rows(db_filename) -> list[dict]:
    """One dict per recorded job, sorted by slurm id."""
    rows = []
    with JobDatabase.get_database(db_filename) as db:
        for _, jobs in db.iterate_database():
            for jd in jobs:
                attrs = db.db[JobDatabase.get_table_name(jd)].attrs
                # .item() unwraps numpy scalars so features print as plain numbers
                numerics = {k: v.item() if hasattr(v, "item") else v for k, v in jd.numerics.items()}
                rows.append(
                    {
                        "slurm_id": jd.slurm_id,
                        "job_name": jd.job_name,
                        "runtime": jd.runtime,
                        "memory": jd.memory,
                        "method": attrs.get("method", None),
                        "state": attrs.get("state", None),
                        "features": {**jd.categories, **numerics},
                    }
                )
    # Numerically, not lexically: slurm ids grow, and a string sort would put
    # "9999999" after "10000000". A job's steps stay next to the job.
    rows.sort(key=lambda r: (len(str(r["slurm_id"]).split(".")[0]), str(r["slurm_id"])))
    return rows


def print_db(db_filename) -> None:
    """Print recorded jobs, one row per job (or per step, for a lazy row)."""
    rows = [
        [*(_fmt(row[name]) for name in FIXED_COLUMNS), _features(row["features"])] for row in collect_rows(db_filename)
    ]
    headers = [*HEADERS, "features"]

    # Plain text, sized to the widest cell and never truncated. A clipped value
    # is both unreadable and silently unmatchable by anything grepping this
    # output, which the tutorial's `#>` checks do.
    widths = [max(len(head), *(len(row[col]) for row in rows), 0) for col, head in enumerate(headers)]

    def line(cells):
        # Every cell but the last is padded to its column; `features` runs to
        # the end of the line, so it needs no width of its own.
        padded = "  ".join(cell.ljust(width) for cell, width in zip(cells[:-1], widths))
        return f"{padded}  {cells[-1]}".rstrip()

    click.echo(line(headers))
    click.echo(line(["-" * width for width in widths]))
    for row in rows:
        click.echo(line(row))


# ---------------------------------------------------------------------------
# CLI (click, like the real slurmise). The wrapped command (everything after
# the first `--`) is split off in __main__ and passed via ctx.obj["command"],
# because click consumes the `--` separator itself.
# ---------------------------------------------------------------------------


@click.group()
@click.option(
    "--toml",
    "-t",
    type=click.Path(exists=True),
    required=False,
    help="Path to the slurmise configuration file (required for record/lazy-record)",
)
@click.pass_context
def main(ctx, toml):
    ctx.ensure_object(dict)  # obj already carries "command" from __main__
    ctx.obj["toml"] = pathlib.Path(toml) if toml else None


def _config(ctx) -> SlurmiseConfiguration:
    if ctx.obj["toml"] is None:
        raise click.UsageError("this command requires --toml")
    return SlurmiseConfiguration(ctx.obj["toml"])


def _db_filename(ctx):
    """DB path from --toml when given, else the default ./slurmise.h5."""
    if ctx.obj["toml"] is not None:
        return SlurmiseConfiguration(ctx.obj["toml"]).db_filename
    return pathlib.Path("slurmise.h5")


@main.command()
@click.argument("cmd", nargs=1)
@click.option("--step-id", type=str, default=None, help="SLURM step id this record belongs to")
@click.pass_context
def record(ctx, cmd, step_id):
    """Eager record: run `srun CMD` first, then pass CMD here as one quoted string.

        srun ../bin/perfectScaler --intensity 2000 --duration 5
        ./slrmise --toml slurmise.toml record --step-id 0 \\
            "perfectScaler --intensity 2000 --duration 5"

    This is upstream `slurmise record`, plus two bookkeeping attributes
    (`method` and `state`) so `display` can show it beside a lazy row.

    Runs in the batch shell, which has no SLURM_STEP_ID, so it cannot know which
    srun step just finished -- hence `--step-id`. Without it, sacct's last
    listed step is used (upstream's heuristic).
    """
    config = _config(ctx)
    mock_usage = declared_usage()

    if mock_usage:
        # No scheduler: invent an id rather than reading one from the environment.
        mock_job, mock_step = next_mock_step(config.db_filename)
        jd = config.parse_job_cmd(cmd=cmd, slurm_id=mock_job, step_id=step_id or mock_step)
        jd.runtime, jd.memory = mock_usage["used_time"], mock_usage["used_mem"]
        state = "COMPLETED"
    else:
        jd = config.parse_job_cmd(cmd=cmd, step_id=step_id)
        jd.slurm_id = slurm.resolve_job_id(jd.slurm_id)
        job_id, resolved_step = slurm.split_job_id(jd.slurm_id)
        try:
            metadata = slurm.parse_slurm_job_metadata(job_id, resolved_step)
        except ValueError as e:
            raise click.ClickException(
                f"Could not fetch sacct metadata for {jd.slurm_id} right after it ran. This is the "
                "eager-record race: slurmdbd may not have the step's accounting data yet. "
                "`lazy-record` does not have this problem."
            ) from e
        jd.runtime, jd.memory = metadata["elapsed_seconds"], metadata["max_rss"]
        state = metadata["state"]

    with JobDatabase.get_database(config.db_filename) as db:
        db.record(jd)
        set_job_attrs(db, jd, method="eager", state=state)


@main.command("lazy-record")
@click.pass_context
def lazy_record(ctx):
    """Lazy record: wrap the command, record a stub, then become it.

        srun ./slrmise --toml slurmise.toml lazy-record -- \\
            ../bin/perfectScaler --intensity 3000 --duration 5

    The command is written once. Because this runs *inside* the srun step it
    reads SLURM_STEP_ID itself, so the row is keyed `<jobid>.<stepid>` with no
    bookkeeping by the caller.

    Metrics are absent until `sync` fills them in once the step is terminal --
    never during this call, which happens before the command has even started.

    The last thing it does is `os.execvp`, replacing itself with the wrapped
    command: no python process is left alive during the run, so exit codes,
    signals, and memory accounting all belong to the real command.
    """
    command = ctx.obj["command"]
    if not command:
        raise click.UsageError("lazy-record requires a command after `--`")
    config = _config(ctx)
    mock_usage = declared_usage()

    if mock_usage:
        job_id, step_id = next_mock_step(config.db_filename)
    else:
        job_id, step_id = slurm.get_current_job_id(), os.environ.get("SLURM_STEP_ID")
        if job_id is None:
            raise click.ClickException("lazy-record must be run inside a SLURM job step (srun ./slrmise ...)")

    jd = config.parse_job_cmd(
        cmd=" ".join(command[1:]),
        job_name=pathlib.Path(command[0]).name,
        slurm_id=job_id,
        step_id=step_id,
    )

    with JobDatabase.get_database(config.db_filename) as db:
        db.record(jd)  # no memory/runtime yet -- that absence *is* the stub
        set_job_attrs(db, jd, method="lazy", **mock_usage)

    if mock_usage:
        # No scheduler, and nothing worth running: the usage was declared, so
        # say what would have been exec'd rather than actually spending it.
        click.echo(f"Recorded stub {jd.slurm_id}; would now exec: {shlex.join(command)}")
        return

    os.execvp(command[0], command)  # this process is now the wrapped command


@main.command()
@click.pass_context
def sync(ctx):
    """Fill in metrics and states for rows that haven't settled yet."""
    sync_pending(_db_filename(ctx))


@main.command()
@click.option("--no-sync", is_flag=True, help="Print as-is, without syncing pending rows first")
@click.pass_context
def display(ctx, no_sync):
    """Print recorded jobs (syncs pending rows first unless --no-sync)."""
    db_filename = _db_filename(ctx)
    if not no_sync:
        sync_pending(db_filename)
    print_db(db_filename)


if __name__ == "__main__":
    # Split off the wrapped command (everything after the first standalone `--`)
    # before click parses, since click consumes `--` and we need the boundary.
    argv = sys.argv[1:]
    command: list = []
    if "--" in argv:
        idx = argv.index("--")
        argv, command = argv[:idx], argv[idx + 1 :]
    main(args=argv, obj={"command": command})
