#!/usr/bin/env python3
"""Allocates roughly <intensity> MB (+/-20% random noise) and 1MB more
and holds it for <duration> seconds.

The added noise is a harder test for slurmise fits
"""

import argparse
import random
import time


def main():
    parser = argparse.ArgumentParser(description="Allocate noisy memory and hold it for a fixed duration.")
    parser.add_argument("--intensity", type=int, default=1000, help="target megabytes of memory (before noise)")
    parser.add_argument("--duration", type=int, default=2, help="seconds to hold the allocation")
    args = parser.parse_args()

    noise = random.uniform(-0.2, 0.2)
    actual_mb = max(1, round(args.intensity * (1 + noise))) + 1000

    # bytearray zero-fills the buffer, forcing every page resident so the
    # allocation shows up in SLURM's MaxRSS rather than being lazily reserved.
    _ = bytearray(actual_mb * 1024 * 1024)
    time.sleep(args.duration)


if __name__ == "__main__":
    main()
